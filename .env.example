ENVIRONMENT=development
SECRET_KEY=change-me
JWT_SECRET=change-me
DATABASE_URL=sqlite+aiosqlite:///./soro.db
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ALLOWED_ORIGINS=["https://soro.hu"]
WEBHOOK_SECRET=change-me

# Havi cikkkvóták (naptári hó; template-pricing.php csomagokkal egyezően)
# Starter: 10 cikk/hó | Pro: 50 | Agency: nagy szám = gyakorlatilag korlátlan
QUOTA_TRIAL=10
QUOTA_STARTER=10
QUOTA_PRO=50
QUOTA_AGENCY=999999

# Stripe: Products / Prices (Dashboard) — egy Price ID / csomag (havi előfizetés)
# A webes árazás (Ft): Starter ~7 900, Pro ~19 900, Agency ~89 000 — a Stripe-ban ugyanezekhez hozd létre az árakat (HUF vagy EUR, ahogy a fiókod engedi).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
BILLING_SUCCESS_URL=https://soro.hu/dashboard?checkout=success
BILLING_CANCEL_URL=https://soro.hu/arazas?checkout=canceled
BILLING_PORTAL_RETURN_URL=https://soro.hu/dashboard

# SMTP password reset emails. If SMTP_HOST is empty, reset links are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@soro.hu
SMTP_FROM_NAME=Soro.hu
SMTP_USE_TLS=true

# Legacy single quota (unused if per-plan quotas are set)
MONTHLY_ARTICLE_QUOTA=100
